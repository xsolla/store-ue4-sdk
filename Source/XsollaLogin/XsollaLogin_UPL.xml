<root xmlns:android="http://schemas.android.com/apk/res/android">
  <init>
    <log text="XsollaLogin UPL initialization"/>
  </init>

  <!-- Enable AndroidX support -->
  <gradleProperties>
    <insert>
      android.useAndroidX=true
      android.enableJetifier=true
    </insert>
  </gradleProperties>

  <buildGradleAdditions>
    <!-- Add dependencies -->
    <insert>
      dependencies {
        implementation 'com.xsolla.android:bridge:0.1.1'
      }
      repositories {
        mavenCentral()
      }
    </insert>
  </buildGradleAdditions>

  <!-- Add native implementation wrapper -->
  <prebuildCopies>
    <copyDir src="$S(PluginDir)/Private/Android/Java/Common" dst="$S(BuildDir)/src/com/xsolla/login" />
  </prebuildCopies>

  <!-- Addition rules for proguard -->
  <proguardAdditions>
    <insert>
      <![CDATA[
      # ========================
      # General settings
      # ========================
      -keepattributes Signature
      -keepattributes Exceptions
      -keepattributes *Annotation*

      # ========================
      # Xsolla SDK
      # ========================
      -keep class com.xsolla.** { *; }
      -keep interface com.xsolla.** { *; }
      ]]>
    </insert>
  </proguardAdditions>

  <!-- Add custom data to AndroidManifest.xml -->
  <androidManifestUpdates>

    <setElement result="XsollaNativeAdditionalInfoAuthActivity" value="activity"/>
    <addAttribute tag="$XsollaNativeAdditionalInfoAuthActivity" name="android:name" value="com.xsolla.login.XsollaNativeAdditionalInfoAuthActivity"/>
    <addAttribute tag="$XsollaNativeAdditionalInfoAuthActivity" name="android:configChanges" value="orientation|screenSize"/>
    <addAttribute tag="$XsollaNativeAdditionalInfoAuthActivity" name="android:theme" value="@android:style/Theme.Translucent.NoTitleBar"/>
    <addElement tag="application" name="XsollaNativeAdditionalInfoAuthActivity"/>

  </androidManifestUpdates>

</root>
